<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Coconut Leaf Green Theme -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.Light">

        <!-- Primary brand color (coconut leaf green) -->
        <item name="colorPrimary">@color/coconut_green</item>
        <item name="colorPrimaryVariant">@color/coconut_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/coconut_green_light</item>
        <item name="colorSecondaryVariant">@color/coconut_green</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Force light mode (disable dark theme) -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- Material buttons style -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>

        <!-- FAB uses primary color automatically -->
        <item name="colorSecondary">@color/coconut_green</item>
    </style>

</resources>